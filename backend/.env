# Spring datasource (in-memory H2 defaults)
SPRING_DATASOURCE_URL=jdbc:h2:mem:choredb
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=create
SPRING_JPA_SHOW_SQL=true
SPRING_HIBERNATE_FORMAT_SQL=true

# Server
SERVER_PORT=8080

# Static resources (served by Spring)
SPRING_STATIC_LOCATIONS=file:../frontend/

# Owner account (fixed)
APP_OWNER_EMAIL=pranavup.ec23@bitsathy.ac.in
APP_OWNER_PASSWORD=1131

# Basic admin user (Spring Security default creds, currently unused after auth relaxed)
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=admin
